# =============================================================================
# EduFlow Pakistan — Environment Variables
# =============================================================================

# ── Database Configuration ──────────────────────────────────────────────────
# Default SQLite async URL for local development:
DATABASE_URL=sqlite+aiosqlite:///./eduflow.db
# PostgreSQL option (e.g. for Docker / production):
# DATABASE_URL=postgresql+asyncpg://postgres:eduflow@localhost:5432/eduflow

# ── Gemini LLM ──────────────────────────────────────────────────────────────
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# ── Google Cloud / GCS Storage (Optional in DEMO_MODE) ──────────────────────
GOOGLE_CLOUD_PROJECT=eduflow-pakistan
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET=eduflow-submissions

# ── Telegram Bot (replaces Twilio WhatsApp) ─────────────────────────────────
# Create bot via @BotFather on Telegram to get token
TELEGRAM_BOT_TOKEN=

# ── Google OAuth (Optional in DEMO_MODE) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Application URLs & Secrets ─────────────────────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── Frontend Next.js Public Environment Variables ───────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ── Demo Mode Configuration ─────────────────────────────────────────────────
# When True: agents return mock data instantly without requiring live LLM calls
DEMO_MODE=True
DEMO_TEACHER_EMAIL=ayesha.raza@lahoremodel.edu.pk
DEMO_AUTO_LOGIN=True
