# =============================================================================
# EduFlow Pakistan — Backend Environment Variables
# =============================================================================

# Database
DATABASE_URL=sqlite+aiosqlite:///./eduflow.db
# DATABASE_URL=postgresql+asyncpg://postgres:eduflow@localhost:5432/eduflow

# Gemini LLM
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

# Google Cloud / GCS
GOOGLE_CLOUD_PROJECT=eduflow-pakistan
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET=eduflow-submissions

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# App Configuration
SECRET_KEY=dev-secret-key-change-in-production
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Demo Mode
DEMO_MODE=True
DEMO_TEACHER_EMAIL=ayesha.raza@lahoremodel.edu.pk
DEMO_AUTO_LOGIN=True
